<% content_for :title, 'Reset your Crabazon password' %>
<%= render 'shared/email_heading', text: 'Reset your password' %>
<p style="mso-table-lspace:0;mso-table-rspace:0; margin:0; padding:0 1px 15px"><span style="font-family: 'Roboto', Helvetica, Arial, sans-serif !important;">Someone asked to reset the password for <%= @resource.email %>. Choose a new one with the button below.</span></p>
<%= render 'shared/email_button', url: edit_password_url(@resource, reset_password_token: @token), label: 'Choose a new password' %>
<p style="mso-table-lspace:0;mso-table-rspace:0; margin:0; padding:0 1px 15px"><span style="font-family: 'Roboto', Helvetica, Arial, sans-serif !important;">The link works for 6 hours. If you didn't ask for this, ignore this email; your password won't change.</span></p>

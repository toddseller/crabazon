<%= render layout: 'devise/shared/card', locals: { title: 'Check your email' } do %>
  <p>If an account uses <strong><%= @email.presence || 'your email address' %></strong>, we've sent it a link to reset your password.</p>
  <p>The link works for 6 hours. If it doesn't arrive in a few minutes, check your spam folder.</p>
<% end %>
